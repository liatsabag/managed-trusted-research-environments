# ==============================================================================
# GCP Health Data Platform - Central Administrator Portal
# Environment Configuration Template
# ==============================================================================

# Core GCP Settings
GCP_PROJECT_ID=gcp-rr-hub-core
GCP_REGION=me-west1
ADMIN_DOMAIN=liatsabag.altostrat.com

# BigQuery Detailed Billing Export Configuration
BILLING_PROJECT_ID=gcp-rr-hub-core
BILLING_DATASET_ID=billing
BILLING_EXPORT_TABLE=gcp_billing_export_v1

# Hub Governance & Telemetry Datasets
HUB_REGISTRY_DATASET=hub_registry
HUB_TELEMETRY_DATASET=hub_telemetry

# Vertex AI Model Configuration
VERTEX_AI_MODEL=gemini-3.7-flash
VERTEX_AI_LOCATION=me-west1

# API & Networking
CORS_ORIGINS=["*"]
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
