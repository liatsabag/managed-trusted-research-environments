        <!-- ZONE 1: RESEARCHER CLIENT SPACE -->
        <mxCell id="zone1_container" value="&lt;b style=&quot;color:#202124;font-size:13px;&quot;&gt;1. Researcher Client Space&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dadce0;strokeWidth=2;fontFamily=Google Sans;rounded=1;arcSize=3;startSize=35;horizontal=1;" vertex="1" parent="1">
