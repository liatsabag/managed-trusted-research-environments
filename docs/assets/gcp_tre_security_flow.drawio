        <!-- HEADER BANNER -->
        <mxCell id="hdr_banner" value="&lt;table border=&quot;0&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;height:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:55px;vertical-align:middle;text-align:center;&quot;&gt;&lt;img src=&quot;data:image/png;base64,&quot; width=&quot;40&quot; height=&quot;40&quot;/&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:middle;text-align:left;padding-left:8px;&quot;&gt;&lt;b style=&quot;font-size:15px;color:#202124;&quot;&gt;Defense-in-Depth Security Architecture &amp;amp; Researcher Access Flow&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;color:#5f6368;&quot;&gt;Local Device  &#8594;  Zero-Trust Ingress (IAP &amp;amp; Bastion)  &#8594;  VPC-SC Perimeter  &#8594;  Tenant Spoke Room &amp;amp; Central Hub&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;strokeWidth=1.5;fontFamily=Google Sans;" vertex="1" parent="1">
