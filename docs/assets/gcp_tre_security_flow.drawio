        <mxCell id="spoke_room_container" value="&lt;b style=&quot;color:#188038;font-size:12px;&quot;&gt;Tenant Spoke Project: gcp-rr-spoke-*&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#188038;strokeWidth=2;fontFamily=Google Sans;rounded=1;arcSize=3;startSize=30;horizontal=1;" vertex="1" parent="zone3_vpc_sc">
