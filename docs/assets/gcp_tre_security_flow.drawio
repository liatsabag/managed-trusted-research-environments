        <!-- Spoke Item 1: Colab Enterprise -->
        <mxCell id="spoke_colab" value="&lt;table border=&quot;0&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;height:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:45px;vertical-align:top;padding-top:4px;&quot;&gt;&lt;img src=&quot;data:image/png;base64,&quot; width=&quot;36&quot; height=&quot;36&quot;/&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;padding-left:6px;&quot;&gt;&lt;b style=&quot;color:#202124;font-size:11.5px;&quot;&gt;Colab Enterprise Notebook Runtime&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9.5px;color:#1a73e8;&quot;&gt;[Isolated Interactive Compute]&lt;/span&gt;&lt;div style=&quot;margin-top:5px;font-size:10px;color:#3c4043;line-height:1.4;&quot;&gt;&#8226; Private Subnet (disable_public_ip = true)&lt;br/&gt;&#8226; Shielded VM (Secure Boot &amp;amp; vTPM)&lt;br/&gt;&#8226; Internal Cloud NAT &amp;amp; Private Google Access&lt;br/&gt;&#8226; Zero direct external Internet routing&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;strokeWidth=1.5;fontFamily=Google Sans;padding=8;" vertex="1" parent="spoke_room_container">
          <mxGeometry x="15" y="40" width="395" height="135" as="geometry" />
        </mxCell>

        <!-- Spoke Item 2: Local BigQuery Sandbox -->
        <mxCell id="spoke_bq" value="&lt;table border=&quot;0&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;height:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:45px;vertical-align:top;padding-top:4px;&quot;&gt;&lt;img src=&quot;data:image/png;base64,&quot; width=&quot;36&quot; height=&quot;36&quot;/&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;padding-left:6px;&quot;&gt;&lt;b style=&quot;color:#1a73e8;font-size:11.5px;&quot;&gt;Local BigQuery Study Sandbox&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9.5px;color:#1a73e8;&quot;&gt;[Isolated Analytical Storage]&lt;/span&gt;&lt;div style=&quot;margin-top:5px;font-size:10px;color:#3c4043;line-height:1.4;&quot;&gt;&#8226; Dataset: &lt;b&gt;study_analytics_sandbox&lt;/b&gt;&lt;br/&gt;&#8226; Ingest and stage inbound reference datasets&lt;br/&gt;&#8226; Execute intermediate transformations &amp;amp; models&lt;br/&gt;&#8226; Results export disabled by Org Policy&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;strokeWidth=1.5;fontFamily=Google Sans;padding=8;" vertex="1" parent="spoke_room_container">
          <mxGeometry x="15" y="190" width="395" height="135" as="geometry" />
        </mxCell>

        <!-- Spoke Item 3: Dual-Bucket Architecture -->
        <mxCell id="spoke_gcs_box" value="&lt;b style=&quot;color:#f29900;font-size:11.5px;&quot;&gt;Dual-Bucket GCS Architecture&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f29900;strokeWidth=1.5;fontFamily=Google Sans;rounded=1;arcSize=3;startSize=26;horizontal=1;" vertex="1" parent="spoke_room_container">
          <mxGeometry x="15" y="340" width="395" height="330" as="geometry" />
        </mxCell>

        <!-- Inbound Bucket -->
        <mxCell id="spoke_inbound" value="&lt;table border=&quot;0&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;height:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:40px;vertical-align:top;padding-top:2px;&quot;&gt;&lt;img src=&quot;data:image/png;base64,&quot; width=&quot;32&quot; height=&quot;32&quot;/&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;padding-left:6px;&quot;&gt;&lt;b style=&quot;color:#188038;font-size:11px;&quot;&gt;Inbound: gs://rr-*-inbound&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;color:#188038;font-weight:bold;&quot;&gt;[READ-ONLY FOR RESEARCHERS]&lt;/span&gt;&lt;div style=&quot;margin-top:4px;font-size:9.5px;color:#3c4043;line-height:1.35;&quot;&gt;&#8226; Provisioned reference genomics &amp;amp; cohorts&lt;br/&gt;&#8226; Approved Python packages &amp;amp; pipelines&lt;br/&gt;&#8226; Write operations blocked via IAM&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#188038;strokeWidth=1.2;fontFamily=Google Sans;padding=6;" vertex="1" parent="spoke_gcs_box">
          <mxGeometry x="15" y="35" width="365" height="120" as="geometry" />
        </mxCell>

        <!-- Quarantine Bucket -->
        <mxCell id="spoke_quarantine" value="&lt;table border=&quot;0&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;height:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:40px;vertical-align:top;padding-top:2px;&quot;&gt;&lt;img src=&quot;data:image/png;base64,&quot; width=&quot;32&quot; height=&quot;32&quot;/&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;padding-left:6px;&quot;&gt;&lt;b style=&quot;color:#d93025;font-size:11px;&quot;&gt;Quarantine: gs://rr-*-export&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;color:#d93025;font-weight:bold;&quot;&gt;[WRITE-ONLY FOR RESEARCHERS]&lt;/span&gt;&lt;div style=&quot;margin-top:4px;font-size:9.5px;color:#3c4043;line-height:1.35;&quot;&gt;&#8226; Output artifacts deposited for evaluation&lt;br/&gt;&#8226; Candidate models, summary tables, plots&lt;br/&gt;&#8226; Strictly locked inside perimeter until Air-Lock scan&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#d93025;strokeWidth=1.2;fontFamily=Google Sans;padding=6;" vertex="1" parent="spoke_gcs_box">
          <mxGeometry x="15" y="175" width="365" height="140" as="geometry" />
