        <!-- 1A: Verified Researcher -->
        <mxCell id="c1_researcher" value="&lt;table border=&quot;0&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;height:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:45px;vertical-align:top;padding-top:4px;&quot;&gt;&lt;img src=&quot;data:image/png;base64,&quot; width=&quot;36&quot; height=&quot;36&quot;/&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;padding-left:6px;&quot;&gt;&lt;b style=&quot;color:#1a73e8;font-size:12px;&quot;&gt;Verified Researcher&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9.5px;color:#1a73e8;&quot;&gt;[Authenticated Identity]&lt;/span&gt;&lt;div style=&quot;margin-top:6px;font-size:10px;color:#3c4043;line-height:1.4;&quot;&gt;&#8226; Cloud Identity SSO (MFA)&lt;br/&gt;&#8226; Context-Aware Access (CAA)&lt;br/&gt;&#8226; Managed Corporate Device&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;strokeWidth=1.5;fontFamily=Google Sans;padding=8;" vertex="1" parent="zone1_container">
          <mxGeometry x="15" y="50" width="280" height="135" as="geometry" />
        </mxCell>

        <!-- 1B: Chrome Enterprise -->
        <mxCell id="c1_chrome" value="&lt;table border=&quot;0&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;height:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:45px;vertical-align:top;padding-top:4px;&quot;&gt;&lt;img src=&quot;data:image/png;base64,&quot; width=&quot;36&quot; height=&quot;36&quot;/&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;padding-left:6px;&quot;&gt;&lt;b style=&quot;color:#9334e6;font-size:12px;&quot;&gt;Chrome Enterprise&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9.5px;color:#5f6368;&quot;&gt;[Recommended Workstation Agent]&lt;/span&gt;&lt;div style=&quot;margin-top:6px;font-size:10px;color:#3c4043;line-height:1.4;&quot;&gt;&#8226; Block Clipboard / Copy-Paste&lt;br/&gt;&#8226; Block Screen Capture / Snip&lt;br/&gt;&#8226; Block Local File Downloads&lt;br/&gt;&#8226; Dynamic Forensic Watermarking&lt;br/&gt;&#8226; Restrict URL Navigation strictly to TRE&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8fd;strokeColor=#9334e6;strokeWidth=1.5;fontFamily=Google Sans;padding=8;" vertex="1" parent="zone1_container">
          <mxGeometry x="15" y="205" width="280" height="200" as="geometry" />
        </mxCell>

        <!-- 1C: BigQuery Studio Restriction -->
        <mxCell id="c1_bq_policy" value="&lt;table border=&quot;0&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;height:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:45px;vertical-align:top;padding-top:4px;&quot;&gt;&lt;img src=&quot;data:image/png;base64,&quot; width=&quot;36&quot; height=&quot;36&quot;/&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;padding-left:6px;&quot;&gt;&lt;b style=&quot;color:#b06000;font-size:12px;&quot;&gt;BQ Studio Download Policy&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9.5px;color:#5f6368;&quot;&gt;[Native Google Cloud Org Policy]&lt;/span&gt;&lt;div style=&quot;margin-top:6px;font-size:10px;color:#3c4043;line-height:1.4;&quot;&gt;&#8226; Restrict Downloading Query Results&lt;br/&gt;&#8226; Queries execute purely in-enclave&lt;br/&gt;&#8226; Output routed only to GCS / BQ tables&lt;br/&gt;&#8226; Prevents direct browser exfiltration&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f29900;strokeWidth=1.5;fontFamily=Google Sans;padding=8;" vertex="1" parent="zone1_container">
          <mxGeometry x="15" y="425" width="280" height="175" as="geometry" />
        </mxCell>

        <!-- 1D: Device Posture Notes -->
        <mxCell id="c1_posture_note" value="&lt;div style=&quot;text-align:left;font-size:10px;color:#5f6368;line-height:1.4;&quot;&gt;&lt;b&gt;Why Client-Side Controls?&lt;/b&gt;&lt;br/&gt;VPC-SC secures network and API transfers between cloud projects, while Chrome Enterprise prevents data leakage from the local researcher workstation (copy-paste, print-screen).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;strokeWidth=1;fontFamily=Google Sans;spacing=8;" vertex="1" parent="zone1_container">
          <mxGeometry x="15" y="620" width="280" height="150" as="geometry" />
        </mxCell>

        <!-- ZONE 2: ZERO-TRUST INGRESS GATEWAY -->
        <mxCell id="zone2_container" value="&lt;b style=&quot;color:#1a73e8;font-size:13px;&quot;&gt;2. Zero-Trust Access Gateway&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a73e8;strokeWidth=2;fontFamily=Google Sans;rounded=1;arcSize=3;startSize=35;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="100" width="280" height="800" as="geometry" />
        </mxCell>

        <!-- 2A: Cloud IAP -->
        <mxCell id="c2_iap" value="&lt;table border=&quot;0&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;height:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:45px;vertical-align:top;padding-top:4px;&quot;&gt;&lt;img src=&quot;data:image/png;base64,&quot; width=&quot;36&quot; height=&quot;36&quot;/&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;padding-left:6px;&quot;&gt;&lt;b style=&quot;color:#202124;font-size:12px;&quot;&gt;Identity-Aware Proxy&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9.5px;color:#1a73e8;&quot;&gt;[Recommended Ingress Gateway]&lt;/span&gt;&lt;div style=&quot;margin-top:6px;font-size:10px;color:#3c4043;line-height:1.4;&quot;&gt;&#8226; Zero Public IPs (disable_public_ip)&lt;br/&gt;&#8226; Context-Aware Access (CAA)&lt;br/&gt;&#8226; Encrypted TCP Tunnel (TLS 443)&lt;br/&gt;&#8226; Central Audit Logging in Cloud Audit&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;strokeWidth=1.5;fontFamily=Google Sans;padding=8;" vertex="1" parent="zone2_container">
          <mxGeometry x="15" y="50" width="250" height="190" as="geometry" />
        </mxCell>

        <!-- 2B: Managed Jumper VM -->
        <mxCell id="c2_jumper" value="&lt;table border=&quot;0&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;height:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:45px;vertical-align:top;padding-top:4px;&quot;&gt;&lt;img src=&quot;data:image/png;base64,&quot; width=&quot;36&quot; height=&quot;36&quot;/&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;padding-left:6px;&quot;&gt;&lt;b style=&quot;color:#202124;font-size:12px;&quot;&gt;Managed Jumper VM&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9.5px;color:#188038;&quot;&gt;[Hardened Corporate Bastion]&lt;/span&gt;&lt;div style=&quot;margin-top:6px;font-size:10px;color:#3c4043;line-height:1.4;&quot;&gt;&#8226; Shielded VM (Secure Boot &amp;amp; vTPM)&lt;br/&gt;&#8226; Dedicated Private Ingress Subnet&lt;br/&gt;&#8226; Sole Authorized Origin for Spokes&lt;br/&gt;&#8226; Ephemeral Sessions Bound to Identity&lt;br/&gt;&#8226; GUI &amp;amp; Terminal Session Recording&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;strokeWidth=1.5;fontFamily=Google Sans;padding=8;" vertex="1" parent="zone2_container">
          <mxGeometry x="15" y="270" width="250" height="230" as="geometry" />
        </mxCell>

        <!-- 2C: Ingress Note -->
        <mxCell id="c2_ingress_note" value="&lt;div style=&quot;text-align:left;font-size:10px;color:#5f6368;line-height:1.4;&quot;&gt;&lt;b&gt;Guaranteed Ingress Origin&lt;/b&gt;&lt;br/&gt;By forcing all connections through IAP and Jumper VMs, researchers never access the underlying VPC directly from the public internet. All traffic enters with verified device identities.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;strokeWidth=1;fontFamily=Google Sans;spacing=8;" vertex="1" parent="zone2_container">
          <mxGeometry x="15" y="530" width="250" height="240" as="geometry" />
        </mxCell>

        <!-- ZONE 3: VPC SERVICE CONTROLS PERIMETER -->
        <mxCell id="zone3_vpc_sc" value="&lt;table border=&quot;0&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:30px;vertical-align:middle;&quot;&gt;&lt;img src=&quot;data:image/png;base64,&quot; width=&quot;22&quot; height=&quot;22&quot;/&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:middle;padding-left:4px;&quot;&gt;&lt;b style=&quot;color:#d93025;font-size:13px;&quot;&gt;3. VPC Service Controls (VPC-SC) Perimeter Enclave&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;text-align:right;vertical-align:middle;padding-right:15px;&quot;&gt;&lt;span style=&quot;color:#188038;font-size:11px;font-weight:bold;&quot;&gt;[FULLY IMPLEMENTED IN PLATFORM]&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fef0ef;strokeColor=#d93025;strokeWidth=2.5;fontFamily=Google Sans;rounded=1;arcSize=2;startSize=35;horizontal=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="100" width="930" height="800" as="geometry" />
        </mxCell>

        <!-- Protected APIs Strip -->
        <mxCell id="vpc_sc_apis" value="&lt;b style=&quot;color:#d93025;font-size:11px;&quot;&gt;RESTRICTED APIS:&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#3c4043;font-size:10.5px;&quot;&gt;storage.googleapis.com&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;bigquery.googleapis.com&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;notebooks.googleapis.com&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;aiplatform.googleapis.com&lt;/span&gt;&lt;span style=&quot;color:#d93025;font-weight:bold;float:right;margin-right:15px;font-size:10.5px;&quot;&gt;[Cross-Project Egress Blocked]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d93025;strokeWidth=1;align=left;spacingLeft=15;fontFamily=Google Sans;" vertex="1" parent="zone3_vpc_sc">
