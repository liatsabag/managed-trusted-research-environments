        <!-- 3B: CENTRAL GOVERNANCE HUB PROJECT -->
        <mxCell id="hub_room_container" value="&lt;b style=&quot;color:#1a73e8;font-size:12px;&quot;&gt;Central Governance Hub: gcp-rr-hub-core&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1a73e8;strokeWidth=2;fontFamily=Google Sans;rounded=1;arcSize=3;startSize=30;horizontal=1;" vertex="1" parent="zone3_vpc_sc">
          <mxGeometry x="480" y="90" width="430" height="690" as="geometry" />
        </mxCell>

        <!-- Hub Item 1: Analytics Hub -->
        <mxCell id="hub_analytics_hub" value="&lt;table border=&quot;0&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;height:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:45px;vertical-align:top;padding-top:4px;&quot;&gt;&lt;img src=&quot;data:image/png;base64,&quot; width=&quot;36&quot; height=&quot;36&quot;/&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;padding-left:6px;&quot;&gt;&lt;b style=&quot;color:#202124;font-size:11.5px;&quot;&gt;Analytics Hub Data Exchanges&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9.5px;color:#188038;&quot;&gt;[Zero-Copy Central Sharing]&lt;/span&gt;&lt;div style=&quot;margin-top:5px;font-size:10px;color:#3c4043;line-height:1.4;&quot;&gt;&#8226; Curated institutional master clinical registries&lt;br/&gt;&#8226; Zero physical data copies (read linked views in-place)&lt;br/&gt;&#8226; Row-Level Security (RLS) &amp;amp; Dataplex Policy Tags&lt;br/&gt;&#8226; Column masking on sensitive PHI identifiers&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;strokeWidth=1.5;fontFamily=Google Sans;padding=8;" vertex="1" parent="hub_room_container">
          <mxGeometry x="15" y="40" width="400" height="135" as="geometry" />
        </mxCell>

        <!-- Hub Item 2: Air-Lock Engine -->
        <mxCell id="hub_airlock" value="&lt;table border=&quot;0&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;height:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:45px;vertical-align:top;padding-top:4px;&quot;&gt;&lt;img src=&quot;data:image/png;base64,&quot; width=&quot;36&quot; height=&quot;36&quot;/&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;padding-left:6px;&quot;&gt;&lt;b style=&quot;color:#d93025;font-size:11.5px;&quot;&gt;Air-Lock Compliance &amp;amp; Egress Engine&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9.5px;color:#d93025;&quot;&gt;[Automated Risk Scan &amp;amp; DPO Review]&lt;/span&gt;&lt;div style=&quot;margin-top:5px;font-size:10px;color:#3c4043;line-height:1.4;&quot;&gt;&#8226; Cloud Workflows triggers DLP privacy scanning&lt;br/&gt;&#8226; Vertex AI protocol &amp;amp; re-identification evaluation&lt;br/&gt;&#8226; DPO Single-Pane Review &amp;amp; Cryptographic Sign-Off&lt;br/&gt;&#8226; Authorized external egress release upon approval&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef0ef;strokeColor=#d93025;strokeWidth=1.5;fontFamily=Google Sans;padding=8;" vertex="1" parent="hub_room_container">
          <mxGeometry x="15" y="190" width="400" height="135" as="geometry" />
        </mxCell>

        <!-- Hub Item 3: Approvals & Audit -->
        <mxCell id="hub_audit" value="&lt;table border=&quot;0&quot; cellpadding=&quot;0&quot; cellspacing=&quot;0&quot; style=&quot;width:100%;height:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:45px;vertical-align:top;padding-top:4px;&quot;&gt;&lt;img src=&quot;data:image/png;base64,&quot; width=&quot;36&quot; height=&quot;36&quot;/&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;text-align:left;padding-left:6px;&quot;&gt;&lt;b style=&quot;color:#1a73e8;font-size:11.5px;&quot;&gt;Compliance Repository &amp;amp; Telemetry&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9.5px;color:#1a73e8;&quot;&gt;[Immutable Governance Plane]&lt;/span&gt;&lt;div style=&quot;margin-top:5px;font-size:10px;color:#3c4043;line-height:1.4;&quot;&gt;&#8226; &lt;b&gt;gs://gcp-rr-hub-approvals&lt;/b&gt;: Signed DSAs &amp;amp; IRB PDFs&lt;br/&gt;&#8226; Automated document status &amp;amp; expiration tracking&lt;br/&gt;&#8226; Central Cloud Logging &amp;amp; Audit Marts&lt;br/&gt;&#8226; Proportional FinOps attribution across spoke rooms&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#dadce0;strokeWidth=1.5;fontFamily=Google Sans;padding=8;" vertex="1" parent="hub_room_container">
          <mxGeometry x="15" y="340" width="400" height="135" as="geometry" />
        </mxCell>

        <!-- Hub Item 4: IAM & VPC-SC Interplay Note -->
        <mxCell id="hub_iam_note" value="&lt;div style=&quot;text-align:left;font-size:10px;color:#3c4043;line-height:1.4;&quot;&gt;&lt;b&gt;Shared Perimeter &amp;amp; Project-Level IAM Boundary:&lt;/b&gt;&lt;br/&gt;&#8226; &lt;b&gt;Spoke Isolation&lt;/b&gt;: While spokes share the perimeter, IAM is strictly scoped per project. Tenants in Spoke A cannot read or access Spoke B data.&lt;br/&gt;&#8226; &lt;b&gt;Hub Operations&lt;/b&gt;: Hub Service Accounts run scans and lifecycle actions across spokes without perimeter boundary friction.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#1a73e8;strokeWidth=1.2;fontFamily=Google Sans;spacing=8;" vertex="1" parent="hub_room_container">
          <mxGeometry x="15" y="490" width="400" height="180" as="geometry" />
        </mxCell>

        <!-- CONNECTORS & DATA FLOWS -->
        <!-- Flow 1: Researcher -> IAP -->
        <mxCell id="flow_res_to_iap" value="TLS 443" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1a73e8;strokeWidth=3;fontColor=#1a73e8;fontSize=10;fontStyle=1;labelBackgroundColor=#e8f0fe;" edge="1" parent="1" source="c1_researcher" target="c2_iap">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Flow 2: IAP -> Jumper VM -->
        <mxCell id="flow_iap_to_jumper" value="TCP Tunnel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1a73e8;strokeWidth=3;fontColor=#1a73e8;fontSize=10;fontStyle=1;labelBackgroundColor=#e8f0fe;" edge="1" parent="1" source="c2_iap" target="c2_jumper">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Flow 3: Jumper VM -> Colab (Crosses VPC-SC) -->
        <mxCell id="flow_jumper_to_colab" value="VPC Peering" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#188038;strokeWidth=3;fontColor=#188038;fontSize=10;fontStyle=1;labelBackgroundColor=#e6f4ea;" edge="1" parent="1" source="c2_jumper" target="spoke_colab">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Flow 4: Analytics Hub -> Spoke BigQuery (Zero-Copy) -->
        <mxCell id="flow_analytics_to_spoke" value="Zero-Copy Linked View" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1a73e8;strokeWidth=2.5;fontColor=#1a73e8;fontSize=10;fontStyle=1;labelBackgroundColor=#e8f0fe;" edge="1" parent="1" source="hub_analytics_hub" target="spoke_bq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Flow 5: Quarantine Bucket -> Air-Lock Review -->
        <mxCell id="flow_quarantine_to_airlock" value="Candidate Egress Scan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d93025;strokeWidth=2.5;fontColor=#d93025;fontSize=10;fontStyle=1;labelBackgroundColor=#fce8e6;" edge="1" parent="1" source="spoke_quarantine" target="hub_airlock">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>